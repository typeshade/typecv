{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@webgpu/types"],
    "moduleSuffixes": [".typeshade", ""],
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "noEmit": false,
    "erasableSyntaxOnly": false
  },
  "include": ["src/gpu/**/*.ts"],
  "exclude": ["src/gpu/**/*.shade.ts"]
}
