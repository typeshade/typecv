// Public website on Workers Static Assets, plus one small Worker for the lab's run records.
// The Worker runs only for /api/*; every other path is served from the static assets.
// Before the first deploy with this file, create the KV namespace and paste its id below
// (scripts/setup-run-records.ps1), and set the RECORDS_READ_TOKEN secret for reading.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typecv-site",
  "account_id": "7c029c2ac777ff3c45a4bcbe67918a1e",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cv.typeshade.dev", "custom_domain": true }],
  "main": "website/worker.mjs",
  "assets": {
    "directory": "./website/dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "kv_namespaces": [{ "binding": "RECORDS", "id": "REPLACE_WITH_RECORDS_KV_ID" }],
}
