---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Code } from 'astro/components';
const intro =
  'Reusable computer vision in TypeScript, with computation on the GPU. Start with geometric vision and sparse reconstruction within a broader foundation for images, correspondence, motion and 3D.';
const sample = `import { ShadeDevice, verifyImagePairGpu } from 'typecv/gpu';\n\nconst device = await ShadeDevice.open();\nconst result = await verifyImagePairGpu(device, first, second, matches);\nawait device.dispose();`;
---

<SiteLayout
  locale="en"
  active="home"
  title="Computer vision, powered by TypeShade"
  description={intro}
>
  <div class="home-content">
    <section class="home-intro">
      <div class="home-copy">
        <p class="eyebrow">TYPECV / COMPUTER VISION</p>
        <h1>
          A clearer view.
          <br />
          From code to geometry.
        </h1>
        <p class="lead">{intro}</p>
        <div class="action-row">
          <a class="button-primary" href="/lab/">
            Run SfM on a video ↗
          </a>
          <a class="button-secondary" href="/docs/">
            Read the guide
          </a>
        </div>
        <p class="small muted">TypeScript → TypeShade → WebGPU</p>
      </div>
      <div class="home-code">
        <div class="code-frame">
          <div class="panel-heading">
            <span class="live-dot"></span>GPU PAIR VERIFICATION<span class="mono">pair.ts</span>
          </div>
          <Code code={sample} lang="ts" />
          <div class="pipeline">
            <span>pixels</span>
            <span>→</span>
            <span>H / E</span>
            <span>→</span>
            <span>R, t</span>
          </div>
        </div>
        <p class="small muted">
          Resident correspondence verification. Geometry runs in a TypeShade WebGPU plan.
        </p>
      </div>
    </section>
    <section class="home-path">
      <div class="section-intro">
        <p class="eyebrow">01 / OPERATORS</p>
        <h2>Computer vision foundations</h2>
        <p>Current operators are reusable independently of an SfM graph.</p>
      </div>
      <div class="path-strip">
        <a href="/docs/gpu-initialization/">
          <span>01</span>
          <strong>Verify correspondence</strong>
          <small>Radial inversion, H/E consensus and relative pose</small>
        </a>
        <a href="/docs/gpu-geometry/">
          <span>02</span>
          <strong>Recover geometry</strong>
          <small>P3P/PnP RANSAC, triangulation and filtering</small>
        </a>
        <a href="/docs/incremental-sfm/">
          <span>03</span>
          <strong>Refine a scene</strong>
          <small>Schur/PCG bundle adjustment</small>
        </a>
      </div>
    </section>
    <section class="home-learning">
      <div>
        <p class="eyebrow">02 / SCOPE</p>
        <h2>CV is the scope. SfM is a subset.</h2>
        <p>
          TypeCV is a growing computer vision library. The current focus is geometric vision and
          sparse 3D, with an experimental TypeShade GPU FAST/BRIEF feature frontend and matching
          operator.
        </p>
        <a class="text-link" href="/docs/gpu-features/">
          Read about GPU features →
        </a>{' '}
        <a class="text-link" href="/docs/roadmap/">
          Explore the roadmap →
        </a>
      </div>
      <div class="home-status">
        <p class="eyebrow">RECORDED EXPERIMENT</p>
        <strong>8 / 8 views</strong>
        <span>1,723 sparse landmarks</span>
        <small>Assumed calibration · no ground truth</small>
        <a href="/docs/experiments/pyramid-8134952/">Inspect the experiment ↗</a>
      </div>
    </section>
    <section class="home-status">
      <h2>Try your own footage</h2>
      <p>
        Choose a local video, extract frames in the browser, then run TypeShade GPU feature matching
        and incremental SfM. Video stays on your device.
      </p>
      <a class="button-primary" href="/lab/">
        Open the SfM lab ↗
      </a>
    </section>
  </div>
</SiteLayout>
