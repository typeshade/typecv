---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SfmLab from '../../components/SfmLab';
const description = '내 영상이나 사진을 브라우저에서 바로 3D로 복원해 봅니다.';
---

<SiteLayout locale="ko" active="lab" title="SfM 실험실" description={description}>
  <div class="lab-main">
    <header class="lab-header">
      <p class="eyebrow">TYPECV / SFＭ LAB</p>
      <h1>영상으로 3D 장면 만들기</h1>
      <p>영상·사진을 브라우저에서 복원하고, 재생하며 카메라와 3D 장면을 살펴보세요.</p>
    </header>
    <SfmLab client:load locale="ko" />
  </div>
</SiteLayout>
