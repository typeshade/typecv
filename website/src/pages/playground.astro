---
import SiteLayout from '../layouts/SiteLayout.astro';
const intro =
  'Generate calibrated synthetic correspondences, then run TypeCV pair verification locally.';
---

<SiteLayout locale="en" active="playground" title="GPU pair verification" description={intro}>
  <div class="lab-main playground-page">
    <header class="lab-header">
      <p class="eyebrow">TYPECV / PLAYGROUND</p>
      <h1>Test a pair. Inspect the result.</h1>
      <p>{intro} Inputs and computation stay in your browser.</p>
    </header>
    <form id="pair-form" class="lab-panel lab-controls">
      <label>
        Execution
        <select name="backend">
          <option value="webgpu">WebGPU</option>
          <option value="cpu">CPU reference (explicit)</option>
        </select>
      </label>
      <label>
        Correspondences
        <select name="count">
          <option>64</option>
          <option selected>128</option>
          <option>256</option>
        </select>
      </label>
      <label>
        Pixel noise
        <select name="noise">
          <option value="0">0 px</option>
          <option value="0.12" selected>
            0.12 px
          </option>
          <option value="0.5">0.5 px</option>
        </select>
      </label>
      <label>
        Mismatches
        <select name="outliers">
          <option value="0">0%</option>
          <option value="20" selected>
            20%
          </option>
          <option value="30">30%</option>
        </select>
      </label>
      <button class="button-primary" id="run" type="submit">
        Verify pair ↗
      </button>
    </form>
    <p id="status" class="lab-status" role="status" aria-live="polite">
      Choose an execution tier, then verify a pair.
    </p>
    <div class="pair-canvases">
      <figure>
        <figcaption>First image</figcaption>
        <canvas id="first-image" width="960" height="600"></canvas>
      </figure>
      <figure>
        <figcaption>Second image</figcaption>
        <canvas id="second-image" width="960" height="600"></canvas>
      </figure>
    </div>
    <p class="small muted">Blue: accepted by E · Red: rejected · Gray: not yet verified</p>
    <div id="results" hidden>
      <h2>Result</h2>
      <dl id="summary" class="metrics"></dl>
      <div class="result-grid">
        <div>
          <h3>Relative pose</h3>
          <pre id="pose"></pre>
        </div>
        <div>
          <h3>Execution details</h3>
          <pre id="execution"></pre>
        </div>
      </div>
    </div>
    <script type="module" src="/runtime/playground.js"></script>
  </div>
</SiteLayout>
