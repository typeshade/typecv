---
import SiteLayout from '../layouts/SiteLayout.astro';
import SfmLab from '../components/SfmLab';
const description = 'Run a video reconstruction experiment locally in your browser.';
---

<SiteLayout locale="en" active="lab" title="SfM lab" description={description}>
  <div class="lab-main">
    <header class="lab-header">
      <p class="eyebrow">TYPECV / SFＭ LAB</p>
      <h1>Reconstruct a scene from video</h1>
      <p>
        Decode every video frame from start to end, keep the frames with enough motion as keyframes,
        and follow feature detection, matching, camera motion and 3D depth as they are computed.
        Explore source-colored 3D points and their original images on the timeline. Calibration is
        assumed; depth and movement use relative units.
      </p>
    </header>
    <SfmLab client:load locale="en" />
  </div>
</SiteLayout>
