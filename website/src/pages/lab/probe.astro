---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TriangulationProbe from '../../components/TriangulationProbe';
const description =
  'Run the triangulation job of a lost lab run in the browser and find the track that hangs.';
---

<SiteLayout locale="en" active="lab" title="Triangulation probe" description={description}>
  <div class="lab-main">
    <header class="lab-header">
      <p class="eyebrow">TYPECV / SFＭ LAB / PROBE</p>
      <h1>Triangulation probe</h1>
      <p>
        The probe runs one triangulation job of the COLMAP south-building sample: 1672 tracks of two
        observations each. It runs three variants of the job, each on a new WebGPU device. When the
        full job loses the device, the probe divides the tracks to find the track whose work hangs.
        The probe sends nothing. It shows the result as JSON for you to copy or download.
      </p>
      <p>
        Add <code>?bounded=1</code> for fenced submissions, or <code>?fp64=float</code> or
        <code>?fp64=integer</code> to force a flavor of the emulated double, as in the
        <a href="/lab/">SfM lab</a>.
      </p>
    </header>
    <TriangulationProbe client:load locale="en" />
  </div>
</SiteLayout>
