---
import ThemeControl from '../components/ThemeControl';
import '../styles/global.css';
type Props = {
  locale: 'en' | 'ko';
  active?: 'home' | 'docs' | 'playground' | 'lab';
  title: string;
  description: string;
};
const { locale, active = 'home', title, description } = Astro.props;
const ko = locale === 'ko';
const prefix = ko ? '/ko' : '';
const alt = Astro.url.pathname.includes('404')
  ? ko
    ? '/'
    : '/ko/'
  : ko
    ? Astro.url.pathname.replace(/^\/ko/, '') || '/'
    : `/ko${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`;
const nav = [
  { href: `${prefix}/`, label: ko ? '소개' : 'Overview', key: 'home' },
  { href: `${prefix}/docs/`, label: ko ? '문서' : 'Documentation', key: 'docs' },
  { href: `${prefix}/playground/`, label: ko ? '플레이그라운드' : 'Playground', key: 'playground' },
  { href: `${prefix}/lab/`, label: ko ? 'SfM 실험실' : 'SfM lab', key: 'lab' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`https://cv.typeshade.dev${Astro.url.pathname}`} />
    <link
      rel="alternate"
      hreflang="en"
      href={`https://cv.typeshade.dev${ko ? alt : Astro.url.pathname}`}
    />
    <link
      rel="alternate"
      hreflang="ko"
      href={`https://cv.typeshade.dev${ko ? Astro.url.pathname : alt}`}
    />
    <title>{title} · TypeCV</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {ko ? '본문으로 건너뛰기' : 'Skip to content'}
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={prefix || '/'} aria-label="TypeCV home">
          <span class="brand-mark">⌗</span>
          <span>TypeCV</span>
        </a>
        <nav class="top-nav" aria-label={ko ? '주 메뉴' : 'Primary navigation'}>
          {nav.map((item) => (
            <a class:list={['top-link', active === item.key && 'is-active']} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-tools">
          <a class="language-link" href={alt}>
            {ko ? 'English' : '한국어'}
          </a>
          <ThemeControl
            client:load
            darkLabel={ko ? '어두운 테마' : 'Dark theme'}
            lightLabel={ko ? '밝은 테마' : 'Light theme'}
          />
        </div>
      </div>
    </header>
    <main id="main" class:list={['site-main', active === 'home' && 'home-main']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>
          {ko
            ? 'TypeScript와 TypeShade GPU로 구현하는 컴퓨터 비전.'
            : 'Computer vision in TypeScript, accelerated by TypeShade.'}
        </span>
        <div>
          <a href="https://github.com/typeshade/typecv">GitHub ↗</a>
          <a href="https://typeshade.dev">TypeShade</a>
          <a href="https://nn.typeshade.dev">TypeNN</a>
        </div>
      </div>
    </footer>
  </body>
</html>
